---
import Layout from "../layouts/Layout.astro"
import SearchResult from "../components/SearchResult.astro"

// Get all stories and books
const allStories = await Astro.glob("../pages/stories/*.md")
const allBooks = await Astro.glob("../pages/books/*.md")

// Combine and sort by date
const allContent = [...allStories, ...allBooks].sort(
  (a, b) =>
    new Date(b.frontmatter.updatedAt).getTime() -
    new Date(a.frontmatter.updatedAt).getTime()
)
---

<Layout
  title="Search — Favour Felix"
  description="Search through all stories and book reviews by Favour Felix"
  canonical=""
  favicon="/favicon.svg"
  img=""
  type="website"
  readTime=""
  publishedDate=""
  lastUpdated=""
  route="/search/"
  noFrontRow={false}
>
  <div class="search-page section">
    <div class="inner">
      <div class="search-hero">
        <h1>Search my <span>*online</span> brain</h1>
        <div class="search-box">
          <input
            type="text"
            id="search-input"
            placeholder="Type to search..."
            autocomplete="off"
          />
        </div>
      </div>

      <div class="search-results">
        <div id="results-count" class="results-count"></div>
        <div id="search-results-container">
          {allContent.map((item) => <SearchResult item={item} />)}
        </div>
        <div id="no-results" class="no-results hidden">
          <p>No results found. Try a different search term.</p>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const searchInput = document.getElementById(
    "search-input"
  ) as HTMLInputElement
  const resultsContainer = document.getElementById("search-results-container")
  const resultsCount = document.getElementById("results-count")
  const noResults = document.getElementById("no-results")
  const allResults = resultsContainer?.querySelectorAll(".search-result-item")

  function performSearch(query: string) {
    if (!query.trim()) {
      // Show all results when search is empty
      allResults?.forEach((result) => {
        ;(result as HTMLElement).style.display = "block"
      })
      if (resultsCount) resultsCount.textContent = ""
      if (noResults) noResults.classList.add("hidden")
      return
    }

    const lowerQuery = query.toLowerCase()
    let matchCount = 0

    allResults?.forEach((result) => {
      const element = result as HTMLElement
      const title = element.getAttribute("data-title")?.toLowerCase() || ""
      const excerpt = element.getAttribute("data-excerpt")?.toLowerCase() || ""
      const tag = element.getAttribute("data-tag")?.toLowerCase() || ""
      const type = element.getAttribute("data-type")?.toLowerCase() || ""

      // Search across title, excerpt, tag, and type
      const matches =
        title.includes(lowerQuery) ||
        excerpt.includes(lowerQuery) ||
        tag.includes(lowerQuery) ||
        type.includes(lowerQuery)

      if (matches) {
        element.style.display = "block"
        matchCount++

        // Highlight matching terms in title and excerpt
        const titleElement = element.querySelector(".result-title")
        const excerptElement = element.querySelector(".result-excerpt")

        if (titleElement) {
          titleElement.innerHTML = highlightText(
            title,
            lowerQuery,
            element.getAttribute("data-title") || ""
          )
        }
        if (excerptElement) {
          excerptElement.innerHTML = highlightText(
            excerpt,
            lowerQuery,
            element.getAttribute("data-excerpt") || ""
          )
        }
      } else {
        element.style.display = "none"
      }
    })

    // Update results count
    if (resultsCount) {
      resultsCount.textContent = `${matchCount} result${
        matchCount !== 1 ? "s" : ""
      } found`
    }

    // Show/hide no results message
    if (noResults) {
      if (matchCount === 0) {
        noResults.classList.remove("hidden")
      } else {
        noResults.classList.add("hidden")
      }
    }
  }

  function highlightText(
    lowerText: string,
    query: string,
    originalText: string
  ): string {
    if (!query.trim()) return originalText

    const index = lowerText.indexOf(query)
    if (index === -1) return originalText

    const before = originalText.substring(0, index)
    const match = originalText.substring(index, index + query.length)
    const after = originalText.substring(index + query.length)

    return `${before}<mark>${match}</mark>${after}`
  }

  // Debounce search for better performance
  let debounceTimer: ReturnType<typeof setTimeout>
  searchInput?.addEventListener("input", (e) => {
    clearTimeout(debounceTimer)
    debounceTimer = setTimeout(() => {
      performSearch((e.target as HTMLInputElement).value)
    }, 300)
  })

  // Focus search input on page load
  searchInput?.focus()
</script>

<style>
  .search-page {
    min-height: calc(100vh - 200px);
    padding: 2rem 0 4rem;
  }

  .search-hero {
    text-align: center;
    margin-bottom: 4rem;
    min-height: 300px;
    display: flex;
    flex-direction: column;
    gap: 2rem;
    padding-top: 5%;
  }

  .search-hero h1 {
    font-size: 3.5rem;
    font-weight: 500;
    margin-bottom: 1rem;
  }

  .search-hero h1 span {
    color: var(--primary-dark);
  }

  .search-hero p {
    font-size: 1.3rem;
    margin-bottom: 2.5rem;
    opacity: 0.8;
  }

  .search-box {
    width: 100%;
    margin: 0 auto;
  }

  #search-input {
    width: 100%;
    height: 80px;
    padding: 0 2rem;
    font-size: 1.5rem;
    border: 1px solid var(--primary-faded);
    border-radius: 20px;
    background: transparent;
    color: #000000;
    outline: none;
    transition: all 0.3s;
  }

  body.dark #search-input {
    color: #ffffff;
  }

  #search-input:focus {
    border-color: var(--primary-dark);
  }

  #search-input::placeholder {
    color: #000000;
    opacity: 0.5;
  }

  body.dark #search-input::placeholder {
    color: #ffffff;
    opacity: 0.5;
  }

  .search-results {
    max-width: 850px;
    margin: 0 auto;
  }

  .results-count {
    font-size: 1rem;
    font-weight: 500;
    margin-bottom: 2rem;
    color: var(--primary-dark);
  }

  .no-results {
    text-align: center;
    padding: 4rem 2rem;
  }

  .no-results p {
    font-size: 1.3rem;
    opacity: 0.6;
  }

  .hidden {
    display: none;
  }

  mark {
    background-color: var(--primary);
    color: var(--primary-deep-dark);
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    font-weight: 600;
  }

  body.dark mark {
    background-color: var(--primary);
    color: var(--primary-deep-dark);
  }

  /* ----------
  MEDIA QUERIES
  ------------*/
  @media screen and (max-width: 600px) {
    .search-hero h1 {
      font-size: 2.5rem;
    }

    .search-hero p {
      font-size: 1.1rem;
      margin-bottom: 2rem;
    }

    #search-input {
      height: 60px;
      font-size: 1.2rem;
      padding: 0 1.5rem;
      border-radius: 16px;
    }

    .search-page {
      padding: 1rem 0 3rem;
    }

    .search-hero {
      margin-bottom: 3rem;
      padding-top: 20%;
    }
  }
</style>
